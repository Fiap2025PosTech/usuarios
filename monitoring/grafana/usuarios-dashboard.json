{
  "dashboard": {
    "title": "Usuarios API - Métricas",
    "tags": ["usuarios", "dotnet", "api"],
    "timezone": "browser",
    "editable": true,
    "panels": [
      {
        "id": 1,
        "title": "Taxa de Requisições HTTP",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "rate(http_requests_received_total{application=\"usuarios-api\"}[5m])",
            "legendFormat": "{{method}} {{route}}"
          }
        ]
      },
      {
        "id": 2,
        "title": "Latência das Requisições (p95)",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{application=\"usuarios-api\"}[5m]))",
            "legendFormat": "{{method}} {{route}}"
          }
        ]
      },
      {
        "id": 3,
        "title": "Total de Requisições por Status Code",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "sum(http_requests_received_total{application=\"usuarios-api\", code=~\"2.*\"})",
            "legendFormat": "2xx Success"
          }
        ]
      },
      {
        "id": 4,
        "title": "Erros (4xx/5xx)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
        "targets": [
          {
            "expr": "sum(http_requests_received_total{application=\"usuarios-api\", code=~\"[45].*\"})",
            "legendFormat": "Errors"
          }
        ]
      },
      {
        "id": 5,
        "title": "Uso de Memória",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
        "targets": [
          {
            "expr": "process_working_set_bytes{application=\"usuarios-api\"} / 1024 / 1024",
            "legendFormat": "Working Set (MB)"
          }
        ]
      },
      {
        "id": 6,
        "title": "CPU Usage",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
        "targets": [
          {
            "expr": "rate(process_cpu_seconds_total{application=\"usuarios-api\"}[5m]) * 100",
            "legendFormat": "CPU %"
          }
        ]
      }
    ]
  }
}
